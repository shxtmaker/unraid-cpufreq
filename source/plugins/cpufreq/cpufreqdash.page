Menu="Dashboard"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'7.3.0','>=') && preg_match('/^6\\.18\\./', php_uname('r'))"
---
<style>
.cpufreq-frequency {
    color: inherit;
    font-family: monospace;
    white-space: nowrap;
}

.cpufreq-frequency-total {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    margin-left: .5rem;
}

.cpufreq-frequency-core {
    display: inline-block;
    margin-left: .5rem;
    font-size: .9em;
}
</style>

<script type="text/javascript">
(function() {
    'use strict';

    if (window.__cpufreqDashboardIntegration) return;
    window.__cpufreqDashboardIntegration = true;

    var endpoint = '/plugins/cpufreq/cpufreq.php?compact=1';
    var refreshMs = 5000;
    var observerWaitMs = 10000;
    var pollTimer = null;
    var observer = null;
    var observerTimer = null;
    var request = null;
    var cachedTile = null;
    var cachedFields = null;

    function cpuTile() {
        return document.querySelector('tbody[data="toggleCPU(true)"]');
    }

    function formatFrequency(mhz) {
        if (typeof mhz !== 'number' || !isFinite(mhz) || mhz < 0) return 'N/A';
        return mhz >= 1000 ? (mhz / 1000).toFixed(2) + ' GHz' : Math.round(mhz) + ' MHz';
    }

    function frequencyElement(className, attribute, value) {
        var element = document.createElement('span');
        element.className = className;
        element.setAttribute(attribute, value);
        element.textContent = 'N/A';
        return element;
    }

    function syncFrequencyColor(frequency, source) {
        if (!frequency || !source) return;
        var color = source.style ? source.style.color : '';
        if (!color && window.getComputedStyle) color = window.getComputedStyle(source).color;
        if (color) frequency.style.color = color;
    }

    function loadRowLabel(loadElement) {
        var row = loadElement.closest('tr');
        return row ? row.querySelector('span.w26') : null;
    }

    function ensureTotalFrequency(tile) {
        var totalLoad = tile.querySelector('span.cpu.load');
        if (!totalLoad) return null;

        var label = loadRowLabel(totalLoad);
        if (!label) return null;

        var total = label.querySelector('[data-cpufreq-average]');
        if (!total) {
            total = frequencyElement('cpufreq-frequency cpufreq-frequency-total', 'data-cpufreq-average', 'true');
            total.innerHTML = '<i class="fa fa-tachometer" title="Average Frequency"></i><span class="cpufreq-frequency-value">N/A</span>';
            label.appendChild(total);
        }
        return total;
    }

    function cpuId(loadElement) {
        for (var i = 0; i < loadElement.classList.length; i++) {
            var match = /^cpu(\d+)$/.exec(loadElement.classList[i]);
            if (match) return parseInt(match[1], 10);
        }
        return null;
    }

    function ensureCoreFrequency(loadElement) {
        var id = cpuId(loadElement);
        if (id === null) return null;

        var label = loadRowLabel(loadElement);
        if (!label) return null;

        var selector = '[data-cpufreq-core="' + id + '"]';
        var existing = label.querySelector(selector);
        if (existing) {
            syncFrequencyColor(existing, loadElement);
            return existing;
        }

        var frequency = frequencyElement('cpufreq-frequency cpufreq-frequency-core', 'data-cpufreq-core', String(id));
        syncFrequencyColor(frequency, loadElement);
        label.appendChild(frequency);
        return frequency;
    }

    function fieldsAreConnected(fields) {
        if (!fields || !fields.average || !fields.average.isConnected ||
            !fields.averageLoad || !fields.averageLoad.isConnected) return false;

        var ids = Object.keys(fields.cores);
        if (ids.length === 0) return false;
        for (var i = 0; i < ids.length; i++) {
            if (!fields.cores[ids[i]] || !fields.cores[ids[i]].isConnected ||
                !fields.coreLoads[ids[i]] || !fields.coreLoads[ids[i]].isConnected) return false;
        }
        return true;
    }

    function ensureFrequencyFields(tile) {
        if (cachedTile === tile && fieldsAreConnected(cachedFields)) return cachedFields;

        var fields = {
            average: ensureTotalFrequency(tile),
            averageLoad: tile.querySelector('span.cpu.load'),
            cores: {},
            coreLoads: {}
        };
        var loads = tile.querySelectorAll('span[class*="load"]');

        for (var i = 0; i < loads.length; i++) {
            var id = cpuId(loads[i]);
            if (id === null) continue;
            var field = ensureCoreFrequency(loads[i]);
            if (field) {
                fields.cores[id] = field;
                fields.coreLoads[id] = loads[i];
            }
        }

        cachedTile = tile;
        cachedFields = fields;
        return fields;
    }

    function updateFields(data) {
        var tile = cpuTile();
        if (!tile || !data) return;

        var fields = ensureFrequencyFields(tile);
        if (fields.average) {
            syncFrequencyColor(fields.average, fields.averageLoad);
            var averageValue = fields.average.querySelector('.cpufreq-frequency-value');
            if (averageValue) averageValue.textContent = formatFrequency(data.avg_mhz);
        }

        var readings = {};
        var cores = Array.isArray(data.cores) ? data.cores : [];
        cores.forEach(function(core) {
            if (!core) return;
            readings[core.cpu !== undefined ? core.cpu : core.core] = core.mhz;
        });

        Object.keys(fields.cores).forEach(function(id) {
            if (!fields.cores[id]) return;
            syncFrequencyColor(fields.cores[id], fields.coreLoads[id]);
            fields.cores[id].textContent = formatFrequency(readings[id]);
        });
    }

    function stopObserver() {
        if (observer) observer.disconnect();
        observer = null;
        if (observerTimer !== null) window.clearTimeout(observerTimer);
        observerTimer = null;
    }

    function stopPolling() {
        if (pollTimer !== null) window.clearInterval(pollTimer);
        pollTimer = null;
    }

    function stopRequest() {
        if (!request) return;
        var pending = request;
        request = null;
        pending.abort();
    }

    function refresh() {
        if (document.hidden || request) return;

        var tile = cpuTile();
        if (!tile) {
            stopPolling();
            cachedTile = null;
            cachedFields = null;
            waitForTile();
            return;
        }

        var current = $.ajax({ url: endpoint, dataType: 'json', timeout: 4000 });
        request = current;
        current
            .done(function(data) { updateFields(data); })
            .fail(function(_xhr, status) {
                if (status !== 'abort') updateFields({ avg_mhz: null, cores: [] });
            })
            .always(function() {
                if (request === current) request = null;
            });
    }

    function startPolling() {
        if (document.hidden || pollTimer !== null) return;
        if (!cpuTile()) {
            waitForTile();
            return;
        }

        stopObserver();
        refresh();
        pollTimer = window.setInterval(refresh, refreshMs);
    }

    function waitForTile() {
        if (document.hidden || observer || cpuTile()) {
            if (cpuTile()) startPolling();
            return;
        }

        if (window.MutationObserver) {
            observer = new MutationObserver(function() {
                if (cpuTile()) startPolling();
            });
            observer.observe(document.body, { childList: true, subtree: true });
            observerTimer = window.setTimeout(stopObserver, observerWaitMs);
        }
    }

    function deactivate() {
        stopPolling();
        stopObserver();
        stopRequest();
    }

    function activate() {
        if (document.hidden) {
            deactivate();
            return;
        }
        if (cpuTile()) startPolling();
        else waitForTile();
    }

    $(function() {
        activate();
        document.addEventListener('visibilitychange', activate);
        window.addEventListener('pagehide', deactivate);
        window.addEventListener('pageshow', activate);
    });
})();
</script>
