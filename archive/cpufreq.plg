<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name      "cpufreq">
<!ENTITY author    "Qoder">
<!ENTITY version   "1.0.5">
<!ENTITY launch    "CPUFreq">
<!ENTITY gitURL    "https://raw.githubusercontent.com/shxtmaker/unraid-cpufreq/main">
<!ENTITY pluginURL "&gitURL;/archive/cpufreq.plg">
<!ENTITY support   "https://github.com/shxtmaker/unraid-cpufreq/issues">
<!ENTITY plgPATH   "/boot/config/plugins/cpufreq">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/cpufreq">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" support="&support;" min="6.9.0">

<CHANGES>
###1.0.5
- Fix 404 on standalone page: rename page to CPUFreq.page (nginx only routes URLs starting with an uppercase letter to the page engine)
###1.0.4
- Per-core detail is now a standalone top navigation page (/cpufreq) instead of Tools sub-page
- Trend chart: fixed Y-axis 1.0G-3.5G with 500 MHz ticks
- Trend chart: higher rendering resolution (min 2x supersampling)
###1.0.3
- Trend chart: dynamic Y-axis scaled to actual data range with round 100 MHz ticks
- Trend chart: crisp rendering at displayed size (HiDPI aware), redraw on resize
###1.0.2
- Fix dashboard integration: use Menu="Dashboard" tile page (mytiles/tbody) per Unraid 6.12+ spec
###1.0.1
- Fix .plg format: use capitalized FILE attributes and INLINE payloads per UNRAID plugin spec
###1.0.0
- Initial release
- Dashboard widget showing average CPU frequency in CPU section
- Dedicated page showing per-core real-time frequency with charts
</CHANGES>

<!--
Payload files are embedded as plain text INLINE (CDATA) and written directly
to the emhttp plugins directory.
-->

<FILE Name="&emhttp;/CPUFreq.page">
<INLINE>
<![CDATA[
Menu="Tasks:130"
Title="CPU Frequency"
Tag="line-chart"
Icon="fa-line-chart"
---
<?PHP
/* Copyright 2026, CPU Frequency Plugin for UNRAID */
/* Per-core CPU real-time frequency page */

$cpufreq_cores = [];
$cpufreq_model = 'Unknown CPU';

$cpuinfo = @file_get_contents('/proc/cpuinfo');
if ($cpuinfo) {
    if (preg_match('/^model name\s*:\s*(.+)$/m', $cpuinfo, $m)) {
        $cpufreq_model = trim($m[1]);
    }
    preg_match_all('/^processor\s*:\s*(\d+).*?^cpu MHz\s*:\s*([\d.]+)/ms', $cpuinfo, $matches, PREG_SET_ORDER);
    foreach ($matches as $match) {
        $cpufreq_cores[] = ['core' => intval($match[1]), 'mhz' => floatval($match[2])];
    }
}
if (empty($cpufreq_cores)) {
    $freq_files = glob('/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq');
    if ($freq_files) {
        natsort($freq_files);
        $i = 0;
        foreach ($freq_files as $f) {
            $val = @file_get_contents($f);
            if ($val !== false) $cpufreq_cores[] = ['core' => $i, 'mhz' => intval(trim($val)) / 1000];
            $i++;
        }
    }
}
$cpufreq_count = count($cpufreq_cores);
?>

<style>
.cf-summary{display:flex;flex-wrap:wrap;gap:14px;margin:14px 0 20px 0;}
.cf-stat{background:#1b1d1f;border:1px solid #333;border-radius:8px;padding:12px 20px;min-width:140px;text-align:center;}
.cf-stat .cf-label{font-size:11px;color:#909090;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;}
.cf-stat .cf-value{font-size:22px;font-weight:bold;color:#486dba;}
.cf-stat .cf-value.cf-green{color:#3ba34f;}
.cf-stat .cf-value.cf-orange{color:#e8a33d;}
.cf-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;margin:14px 0;}
.cf-core{background:#1b1d1f;border:1px solid #333;border-radius:8px;padding:12px 14px;transition:border-color 0.3s;}
.cf-core:hover{border-color:#486dba;}
.cf-core .cf-core-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
.cf-core .cf-core-id{font-size:13px;font-weight:bold;color:#ccc;}
.cf-core .cf-core-mhz{font-size:16px;font-weight:bold;color:#486dba;font-family:monospace;}
.cf-bar-bg{background:#2a2d30;border-radius:4px;height:8px;overflow:hidden;}
.cf-bar{height:100%;border-radius:4px;background:linear-gradient(90deg,#2d6b3f,#486dba);transition:width 0.6s ease;}
.cf-bar.cf-hot{background:linear-gradient(90deg,#e8a33d,#d9534f);}
.cf-chart-box{background:#1b1d1f;border:1px solid #333;border-radius:8px;padding:16px;margin:20px 0;}
.cf-chart-title{font-size:13px;font-weight:bold;color:#ccc;margin-bottom:10px;}
.cf-controls{margin:10px 0;display:flex;align-items:center;gap:16px;}
.cf-controls label{font-size:12px;color:#909090;}
.cf-controls select,.cf-controls button{background:#2a2d30;color:#ccc;border:1px solid #444;border-radius:4px;padding:4px 10px;font-size:12px;cursor:pointer;}
.cf-controls button:hover{border-color:#486dba;}
.cf-updated{font-size:11px;color:#666;margin-left:auto;}
</style>

<div class="cf-controls">
    <label>Refresh Interval:</label>
    <select id="cf-interval" onchange="cfSetInterval(this.value)">
        <option value="1000">1s</option>
        <option value="2000" selected>2s</option>
        <option value="5000">5s</option>
        <option value="10000">10s</option>
    </select>
    <button onclick="cfTogglePause()" id="cf-pause-btn">Pause</button>
    <span class="cf-updated" id="cf-updated"></span>
</div>

<div class="cf-summary">
    <div class="cf-stat"><div class="cf-label">Average</div><div class="cf-value" id="cf-avg">--</div></div>
    <div class="cf-stat"><div class="cf-label">Minimum</div><div class="cf-value cf-green" id="cf-min">--</div></div>
    <div class="cf-stat"><div class="cf-label">Maximum</div><div class="cf-value cf-orange" id="cf-max">--</div></div>
    <div class="cf-stat"><div class="cf-label">Cores</div><div class="cf-value" id="cf-cores"><?=$cpufreq_count?></div></div>
    <div class="cf-stat"><div class="cf-label">Governor</div><div class="cf-value" id="cf-governor" style="font-size:15px;">--</div></div>
</div>

<div class="cf-chart-box">
    <div class="cf-chart-title">Frequency Trend (Average, last 60 samples)</div>
    <canvas id="cf-chart" width="900" height="200" style="width:100%;height:200px;"></canvas>
</div>

<div class="cf-grid" id="cf-grid">
<?PHP foreach ($cpufreq_cores as $c): ?>
    <div class="cf-core" id="cf-core-<?=$c['core']?>">
        <div class="cf-core-head">
            <span class="cf-core-id">Core <?=$c['core']?></span>
            <span class="cf-core-mhz" id="cf-mhz-<?=$c['core']?>"><?=number_format($c['mhz'], 0)?> MHz</span>
        </div>
        <div class="cf-bar-bg"><div class="cf-bar" id="cf-bar-<?=$c['core']?>" style="width:0%"></div></div>
    </div>
<?PHP endforeach; ?>
</div>

<script>
var cfHistory = [];
var cfMaxHistory = 60;
var cfTimer = null;
var cfPaused = false;
var cfIntervalMs = 2000;
var cfBaseMHz = 0;
var cfBoostMHz = 0;

function cfFmt(mhz) {
    return mhz >= 1000 ? (mhz / 1000).toFixed(2) + ' GHz' : Math.round(mhz) + ' MHz';
}

function cfSetInterval(ms) {
    cfIntervalMs = parseInt(ms);
    if (cfTimer) clearInterval(cfTimer);
    if (!cfPaused) cfTimer = setInterval(cfRefresh, cfIntervalMs);
}

function cfTogglePause() {
    cfPaused = !cfPaused;
    document.getElementById('cf-pause-btn').textContent = cfPaused ? 'Resume' : 'Pause';
    if (cfPaused) { if (cfTimer) clearInterval(cfTimer); cfTimer = null; }
    else { cfTimer = setInterval(cfRefresh, cfIntervalMs); }
}

function cfRefresh() {
    $.getJSON('/plugins/cpufreq/cpufreq.php', function(data) {
        if (!data || !data.cores) return;
        cfBaseMHz = data.base_mhz || 0;
        cfBoostMHz = data.boost_mhz || 0;

        // Update summary
        document.getElementById('cf-avg').textContent = cfFmt(data.avg_mhz);
        document.getElementById('cf-min').textContent = cfFmt(data.min_mhz);
        document.getElementById('cf-max').textContent = cfFmt(data.max_mhz);
        document.getElementById('cf-cores').textContent = data.core_count;
        document.getElementById('cf-governor').textContent = data.governor || 'N/A';
        document.getElementById('cf-updated').textContent = 'Updated: ' + new Date(data.timestamp * 1000).toLocaleTimeString();

        // Determine scale max for bars
        var scaleMax = cfBoostMHz > 0 ? cfBoostMHz : (data.max_mhz * 1.2 || 4000);

        // Update per-core cards
        var grid = document.getElementById('cf-grid');
        data.cores.forEach(function(c) {
            var mhzEl = document.getElementById('cf-mhz-' + c.core);
            var barEl = document.getElementById('cf-bar-' + c.core);
            if (!mhzEl) {
                // Dynamically add card for new core (e.g. first load mismatch)
                var div = document.createElement('div');
                div.className = 'cf-core';
                div.id = 'cf-core-' + c.core;
                div.innerHTML = '<div class="cf-core-head"><span class="cf-core-id">Core ' + c.core +
                    '</span><span class="cf-core-mhz" id="cf-mhz-' + c.core + '"></span></div>' +
                    '<div class="cf-bar-bg"><div class="cf-bar" id="cf-bar-' + c.core + '"></div></div>';
                grid.appendChild(div);
                mhzEl = document.getElementById('cf-mhz-' + c.core);
                barEl = document.getElementById('cf-bar-' + c.core);
            }
            mhzEl.textContent = Math.round(c.mhz) + ' MHz';
            var pct = Math.min(100, (c.mhz / scaleMax) * 100);
            barEl.style.width = pct.toFixed(1) + '%';
            barEl.className = 'cf-bar' + (pct > 90 ? ' cf-hot' : '');
        });

        // Push to history and draw chart
        cfHistory.push(data.avg_mhz);
        if (cfHistory.length > cfMaxHistory) cfHistory.shift();
        cfDrawChart();
    });
}

function cfDrawChart() {
    var canvas = document.getElementById('cf-chart');
    var ctx = canvas.getContext('2d');

    // Render at the actual displayed size with supersampling for extra clarity
    var dpr = Math.max(window.devicePixelRatio || 1, 2);
    var cssW = canvas.clientWidth || 900, cssH = canvas.clientHeight || 200;
    if (canvas.width !== Math.round(cssW * dpr) || canvas.height !== Math.round(cssH * dpr)) {
        canvas.width = Math.round(cssW * dpr);
        canvas.height = Math.round(cssH * dpr);
    }
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    var W = cssW, H = cssH;
    var padL = 60, padR = 10, padT = 10, padB = 24;
    var plotW = W - padL - padR, plotH = H - padT - padB;

    ctx.clearRect(0, 0, W, H);

    // Fixed Y range: 1.0 GHz to 3.5 GHz, 500 MHz ticks
    var yMin = 1000, yMax = 3500;
    var steps = 5;
    var step = (yMax - yMin) / steps;
    function yPos(v) {
        v = Math.max(yMin, Math.min(yMax, v));
        return padT + plotH * (1 - (v - yMin) / (yMax - yMin));
    }

    // Grid lines and labels
    ctx.strokeStyle = '#2a2d30';
    ctx.fillStyle = '#777';
    ctx.font = '10px monospace';
    ctx.textAlign = 'right';
    for (var i = 0; i <= steps; i++) {
        var val = yMin + step * i;
        var y = yPos(val);
        ctx.beginPath();
        ctx.moveTo(padL, y);
        ctx.lineTo(W - padR, y);
        ctx.stroke();
        ctx.fillText((val / 1000).toFixed(1) + 'G', padL - 6, y + 3);
    }

    // Base frequency reference line
    if (cfBaseMHz > 0 && cfBaseMHz >= yMin && cfBaseMHz <= yMax) {
        var baseY = yPos(cfBaseMHz);
        ctx.strokeStyle = '#3ba34f';
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(padL, baseY);
        ctx.lineTo(W - padR, baseY);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = '#3ba34f';
        ctx.textAlign = 'left';
        ctx.fillText('Base', W - padR - 30, baseY - 4);
    }

    if (cfHistory.length < 2) return;

    // Draw line
    var n = cfHistory.length;
    ctx.strokeStyle = '#486dba';
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (var j = 0; j < n; j++) {
        var x = padL + (plotW * j / (cfMaxHistory - 1));
        var yy = yPos(cfHistory[j]);
        if (j === 0) ctx.moveTo(x, yy); else ctx.lineTo(x, yy);
    }
    ctx.stroke();

    // Fill area under line
    var lastX = padL + (plotW * (n - 1) / (cfMaxHistory - 1));
    ctx.lineTo(lastX, padT + plotH);
    ctx.lineTo(padL, padT + plotH);
    ctx.closePath();
    ctx.fillStyle = 'rgba(72,109,186,0.12)';
    ctx.fill();
    ctx.lineWidth = 1;

    // Current value dot
    var curY = yPos(cfHistory[n - 1]);
    ctx.beginPath();
    ctx.arc(lastX, curY, 4, 0, Math.PI * 2);
    ctx.fillStyle = '#486dba';
    ctx.fill();
}

window.addEventListener('resize', function() { cfDrawChart(); });

// Initial load and start timer
cfRefresh();
cfTimer = setInterval(cfRefresh, cfIntervalMs);
</script>
]]>
</INLINE>
</FILE>

<FILE Name="&emhttp;/cpufreq.php">
<INLINE>
<![CDATA[
<?PHP
/* Copyright 2026, CPU Frequency Plugin for UNRAID */
/* AJAX endpoint: returns real-time per-core CPU frequency as JSON */

header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-cache, no-store, must-revalidate');
header('Pragma: no-cache');

$cores = [];
$model = '';
$base_freq = 0;
$max_freq = 0;

// Read /proc/cpuinfo for per-core MHz and CPU model
$cpuinfo = @file_get_contents('/proc/cpuinfo');
if ($cpuinfo) {
    // Extract model name
    if (preg_match('/^model name\s*:\s*(.+)$/m', $cpuinfo, $m)) {
        $model = trim($m[1]);
    }
    // Extract base frequency from model name (e.g. "@ 3.60GHz")
    if (preg_match('/@\s*([\d.]+)\s*GHz/i', $model, $b)) {
        $base_freq = floatval($b[1]) * 1000;
    }
    // Extract per-core current frequency
    preg_match_all('/^processor\s*:\s*(\d+).*?^cpu MHz\s*:\s*([\d.]+)/ms', $cpuinfo, $matches, PREG_SET_ORDER);
    foreach ($matches as $match) {
        $cores[] = [
            'core' => intval($match[1]),
            'mhz'  => round(floatval($match[2]), 2)
        ];
    }
}

// Fallback: sysfs cpufreq interface (kHz values)
if (empty($cores)) {
    $freq_files = glob('/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq');
    if ($freq_files) {
        natsort($freq_files);
        $i = 0;
        foreach ($freq_files as $f) {
            $val = @file_get_contents($f);
            if ($val !== false) {
                $cores[] = [
                    'core' => $i,
                    'mhz'  => round(intval(trim($val)) / 1000, 2)
                ];
            }
            $i++;
        }
    }
}

// Read max frequency from sysfs if available
$max_file = '/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq';
if (file_exists($max_file)) {
    $val = @file_get_contents($max_file);
    if ($val !== false) {
        $max_freq = intval(trim($val)) / 1000; // kHz -> MHz
    }
}

// Calculate statistics
$frequencies = array_column($cores, 'mhz');
$core_count = count($cores);
$avg = $core_count > 0 ? round(array_sum($frequencies) / $core_count, 2) : 0;
$min = $core_count > 0 ? round(min($frequencies), 2) : 0;
$max = $core_count > 0 ? round(max($frequencies), 2) : 0;

// Determine scaling governor
$governor = '';
$gov_file = '/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor';
if (file_exists($gov_file)) {
    $governor = trim(@file_get_contents($gov_file));
}

echo json_encode([
    'timestamp'  => time(),
    'model'      => $model,
    'core_count' => $core_count,
    'avg_mhz'    => $avg,
    'min_mhz'    => $min,
    'max_mhz'    => $max,
    'base_mhz'   => $base_freq,
    'boost_mhz'  => $max_freq,
    'governor'   => $governor,
    'cores'      => $cores
], JSON_UNESCAPED_UNICODE);
]]>
</INLINE>
</FILE>

<FILE Name="&emhttp;/cpufreqdash.page">
<INLINE>
<![CDATA[
Menu="Dashboard:0"
Icon="fa-line-chart"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.12.0-beta5', '>')"
---
<?php
/* Copyright 2026, CPU Frequency Plugin for UNRAID */
/* Dashboard tile: average CPU frequency (Unraid 6.12+ movable tile) */

$cpufreq_plugin = "cpufreq";

// Initial values rendered server-side, then refreshed via AJAX
$cpufreq_vals = [];
$cpuinfo = @file_get_contents('/proc/cpuinfo');
if ($cpuinfo) {
    preg_match_all('/^cpu MHz\s*:\s*([\d.]+)/m', $cpuinfo, $m);
    if (!empty($m[1])) $cpufreq_vals = array_map('floatval', $m[1]);
}
if (empty($cpufreq_vals)) {
    foreach (glob('/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq') ?: [] as $f) {
        $v = @file_get_contents($f);
        if ($v !== false) $cpufreq_vals[] = intval(trim($v)) / 1000;
    }
}
$cpufreq_n   = count($cpufreq_vals);
$cpufreq_avg = $cpufreq_n ? array_sum($cpufreq_vals) / $cpufreq_n : 0;
$cpufreq_min = $cpufreq_n ? min($cpufreq_vals) : 0;
$cpufreq_max = $cpufreq_n ? max($cpufreq_vals) : 0;

function cpufreq_dash_fmt($mhz) {
    return $mhz >= 1000 ? number_format($mhz / 1000, 2) . ' GHz' : number_format($mhz, 0) . ' MHz';
}

$avg0 = cpufreq_dash_fmt($cpufreq_avg);
$min0 = cpufreq_dash_fmt($cpufreq_min);
$max0 = cpufreq_dash_fmt($cpufreq_max);

$mytiles[$cpufreq_plugin]['column1'] = <<<EOT
<tbody id="tblCpuFreqDash" title="_(CPU Frequency)_">
<tr><td><i class="fa fa-line-chart f32"></i>
<div class="section">_(CPU Frequency)_<br>
<span><i class="ups fa fa-tachometer"></i>_(Average)_: <span id="cpufreq-dash-head">$avg0</span></span><br><br></div>
<a href="/CPUFreq" title="_(Go to per-core frequency detail)_"><i class="fa fa-fw fa-cog control"></i></a></td></tr>
<tr class="header"><td><span class="w26">_(Average)_</span><span class="w26">_(Minimum)_</span><span class="w26">_(Maximum)_</span></td></tr>
<tr><td><span class="w26"><span id="cpufreq-dash-avg">$avg0</span></span><span class="w26"><span id="cpufreq-dash-min">$min0</span></span><span class="w26"><span id="cpufreq-dash-max">$max0</span></span></td></tr>
<tr><td><span class="w36">_(Cores)_: <span id="cpufreq-dash-cores">$cpufreq_n</span></span><span class="w44">_(Governor)_: <span id="cpufreq-dash-governor">--</span></span></td></tr>
<tr><td><span></span></td></tr>
</tbody>
EOT;
?>

<script type="text/javascript">
(function() {
    function cpufreqFmt(mhz) {
        return mhz >= 1000 ? (mhz / 1000).toFixed(2) + ' GHz' : Math.round(mhz) + ' MHz';
    }
    function cpufreqDashRefresh() {
        $.getJSON('/plugins/cpufreq/cpufreq.php', function(data) {
            if (!data || data.avg_mhz === undefined) return;
            $('#cpufreq-dash-head').text(cpufreqFmt(data.avg_mhz));
            $('#cpufreq-dash-avg').text(cpufreqFmt(data.avg_mhz));
            $('#cpufreq-dash-min').text(cpufreqFmt(data.min_mhz));
            $('#cpufreq-dash-max').text(cpufreqFmt(data.max_mhz));
            $('#cpufreq-dash-cores').text(data.core_count);
            $('#cpufreq-dash-governor').text(data.governor || 'N/A');
        });
    }
    cpufreqDashRefresh();
    setInterval(cpufreqDashRefresh, 3000);
})();
</script>
]]>
</INLINE>
</FILE>

<!-- Install script -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
# Set proper permissions
chmod 644 /usr/local/emhttp/plugins/cpufreq/CPUFreq.page
chmod 644 /usr/local/emhttp/plugins/cpufreq/cpufreq.php
chmod 644 /usr/local/emhttp/plugins/cpufreq/cpufreqdash.page

# Remove obsolete files from previous versions
rm -rf /usr/local/emhttp/plugins/cpufreq/dashboard
rm -f /usr/local/emhttp/plugins/cpufreq/cpufreq.page

# Clean any stale state
rm -f /tmp/cpufreq_*.json 2>/dev/null

echo ""
echo "----------------------------------------------------"
echo " cpufreq plugin installed successfully."
echo " - Dashboard widget: CPU average frequency"
echo " - Page: top navigation bar -> CPU Frequency (/CPUFreq)"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!-- Remove script -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
# Remove plugin files
rm -rf /usr/local/emhttp/plugins/cpufreq
rm -rf /boot/config/plugins/cpufreq
rm -f /tmp/cpufreq_*.json 2>/dev/null

echo ""
echo "cpufreq plugin removed."
echo ""
]]>
</INLINE>
</FILE>

</PLUGIN>
