<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name      "cpufreq">
<!ENTITY author    "shxtmaker">
<!ENTITY version   "2.0.5">
<!ENTITY gitURL    "https://raw.githubusercontent.com/shxtmaker/unraid-cpufreq/main">
<!ENTITY pluginURL "&gitURL;/archive/cpufreq.plg">
<!ENTITY support   "https://github.com/shxtmaker/unraid-cpufreq/issues">
<!ENTITY plgPATH   "/boot/config/plugins/cpufreq">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/cpufreq">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" support="&support;" min="7.3.0">

<CHANGES>
###2.0.5
- Moved frequency nodes to the CPU and Overall Load label spans, isolating them from native load-bar updates.
###2.0.4
- Prevented DOM insertion errors from stopping all frequency rendering when the usage bar is nested.
###2.0.3
- Placed per-CPU and average-frequency values before the usage bar so they remain on the CPU load row.
###2.0.2
- Matched per-CPU and average-frequency text colors to the native CPU load color.
- Mounted average frequency inside the Overall Load row container.
###2.0.1
- Fixed per-processor frequency placement so values remain inside the CPU detail rows.
###2.0.0
- Reworked and verified against Unraid 7.3.2 with Linux 6.18.38-Unraid.
- Retained compatibility loading for Unraid 7.3.0 or newer on the Linux 6.18.x kernel series; other versions are not individually verified.
- Removed the standalone CPU Frequency page and separate Dashboard tile.
- Added per-logical-CPU frequency to the native CPU tile details and average frequency to the overall row.
- Frequency refresh follows Unraid CPU load polling at 5 seconds.
- Reduced periodic work with a compact API response, conditional sysfs fallback, cached DOM bindings, and background-page suspension.
- Improved missing-frequency handling by parsing each logical processor block independently.
###1.0.5
- Fix 404 on standalone page: rename page to CPUFreq.page (nginx only routes URLs starting with an uppercase letter to the page engine)
###1.0.4
- Per-core detail is now a standalone top navigation page (/cpufreq) instead of Tools sub-page
- Trend chart: fixed Y-axis 1.0G-3.5G with 500 MHz ticks
- Trend chart: higher rendering resolution (min 2x supersampling)
###1.0.3
- Trend chart: dynamic Y-axis scaled to actual data range with round 100 MHz ticks
- Trend chart: crisp rendering at displayed size (HiDPI aware), redraw on resize
###1.0.2
- Fix dashboard integration: use Menu="Dashboard" tile page (mytiles/tbody) per Unraid 6.12+ spec
###1.0.1
- Fix .plg format: use capitalized FILE attributes and INLINE payloads per UNRAID plugin spec
###1.0.0
- Initial release
- Dashboard widget showing average CPU frequency in CPU section
- Dedicated page showing per-core real-time frequency with charts
</CHANGES>

<!--
Payload files are embedded as plain text INLINE (CDATA) and written directly
to the emhttp plugins directory.
-->

<FILE Name="&emhttp;/cpufreq.php">
<INLINE>
<![CDATA[
<?PHP
/* Copyright 2026, shxtmaker */
/* AJAX endpoint: returns real-time logical CPU frequency as JSON */

header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-cache, no-store, must-revalidate');
header('Pragma: no-cache');

$compact = isset($_GET['compact']) && $_GET['compact'] === '1';
$cores_by_id = [];
$expected_cpu_ids = [];
$model = '';
$base_freq = 0;
$max_freq = 0;

// Read /proc/cpuinfo once and keep each frequency bound to its processor block.
$cpuinfo = @file_get_contents('/proc/cpuinfo');
if ($cpuinfo) {
    if (!$compact) {
        // Extract model name and its optional base frequency.
        if (preg_match('/^model name\s*:\s*(.+)$/m', $cpuinfo, $m)) {
            $model = trim($m[1]);
        }
        if (preg_match('/@\s*([\d.]+)\s*GHz/i', $model, $b)) {
            $base_freq = floatval($b[1]) * 1000;
        }
    }

    foreach (preg_split('/\R\s*\R/', trim($cpuinfo)) as $block) {
        if (!preg_match('/^processor\s*:\s*(\d+)/m', $block, $processor_match)) continue;

        $cpu_id = intval($processor_match[1]);
        $expected_cpu_ids[$cpu_id] = true;
        if (!preg_match('/^cpu MHz\s*:\s*([\d.]+)/m', $block, $frequency_match)) continue;

        $cores_by_id[$cpu_id] = [
            'cpu'  => $cpu_id,
            'core' => $cpu_id,
            'mhz'  => round(floatval($frequency_match[1]), 2)
        ];
    }
}

// Only scan sysfs when /proc/cpuinfo omitted one or more frequency readings.
if (!$expected_cpu_ids || count($cores_by_id) < count($expected_cpu_ids)) {
    $freq_files = glob('/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq') ?: [];
    natsort($freq_files);
    foreach ($freq_files as $f) {
        if (!preg_match('/\/cpu(\d+)\/cpufreq\//', $f, $match)) continue;
        $cpu_id = intval($match[1]);
        if (isset($cores_by_id[$cpu_id])) continue;

        $val = @file_get_contents($f);
        if ($val !== false && is_numeric(trim($val))) {
            $cores_by_id[$cpu_id] = [
                'cpu'  => $cpu_id,
                'core' => $cpu_id,
                'mhz'  => round(intval(trim($val)) / 1000, 2)
            ];
        }
    }
}

ksort($cores_by_id, SORT_NUMERIC);
$cores = array_values($cores_by_id);

// Calculate statistics from successful readings only.
$frequencies = array_column($cores, 'mhz');
$core_count = count($cores);
$avg = $core_count > 0 ? round(array_sum($frequencies) / $core_count, 2) : null;
$response = $compact
    ? ['avg_mhz' => $avg, 'cores' => $cores]
    : [
        'timestamp'  => time(),
        'core_count' => $core_count,
        'avg_mhz'    => $avg,
        'cores'      => $cores
    ];

if (!$compact) {
    $max_file = '/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq';
    $max_value = @file_get_contents($max_file);
    if ($max_value !== false && is_numeric(trim($max_value))) {
        $max_freq = intval(trim($max_value)) / 1000;
    }

    $gov_file = '/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor';
    $gov_value = @file_get_contents($gov_file);
    $governor = $gov_value === false ? '' : trim($gov_value);

    $response += [
        'model'     => $model,
        'min_mhz'   => $core_count > 0 ? round(min($frequencies), 2) : null,
        'max_mhz'   => $core_count > 0 ? round(max($frequencies), 2) : null,
        'base_mhz'  => $base_freq,
        'boost_mhz' => $max_freq,
        'governor'  => $governor
    ];
}

echo json_encode($response, JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE);
]]>
</INLINE>
</FILE>

<FILE Name="&emhttp;/cpufreqdash.page">
<INLINE>
<![CDATA[
Menu="Dashboard"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'7.3.0','>=') && preg_match('/^6\\.18\\./', php_uname('r'))"
---
<style>
.cpufreq-frequency {
    color: inherit;
    font-family: monospace;
    white-space: nowrap;
}

.cpufreq-frequency-total {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    margin-left: .5rem;
}

.cpufreq-frequency-core {
    display: inline-block;
    margin-left: .5rem;
    font-size: .9em;
}
</style>

<script type="text/javascript">
(function() {
    'use strict';

    if (window.__cpufreqDashboardIntegration) return;
    window.__cpufreqDashboardIntegration = true;

    var endpoint = '/plugins/cpufreq/cpufreq.php?compact=1';
    var refreshMs = 5000;
    var observerWaitMs = 10000;
    var pollTimer = null;
    var observer = null;
    var observerTimer = null;
    var request = null;
    var cachedTile = null;
    var cachedFields = null;

    function cpuTile() {
        return document.querySelector('tbody[data="toggleCPU(true)"]');
    }

    function formatFrequency(mhz) {
        if (typeof mhz !== 'number' || !isFinite(mhz) || mhz < 0) return 'N/A';
        return mhz >= 1000 ? (mhz / 1000).toFixed(2) + ' GHz' : Math.round(mhz) + ' MHz';
    }

    function frequencyElement(className, attribute, value) {
        var element = document.createElement('span');
        element.className = className;
        element.setAttribute(attribute, value);
        element.textContent = 'N/A';
        return element;
    }

    function syncFrequencyColor(frequency, source) {
        if (!frequency || !source) return;
        var color = source.style ? source.style.color : '';
        if (!color && window.getComputedStyle) color = window.getComputedStyle(source).color;
        if (color) frequency.style.color = color;
    }

    function loadRowLabel(loadElement) {
        var row = loadElement.closest('tr');
        return row ? row.querySelector('span.w26') : null;
    }

    function ensureTotalFrequency(tile) {
        var totalLoad = tile.querySelector('span.cpu.load');
        if (!totalLoad) return null;

        var label = loadRowLabel(totalLoad);
        if (!label) return null;

        var total = label.querySelector('[data-cpufreq-average]');
        if (!total) {
            total = frequencyElement('cpufreq-frequency cpufreq-frequency-total', 'data-cpufreq-average', 'true');
            total.innerHTML = '<i class="fa fa-tachometer" title="Average Frequency"></i><span class="cpufreq-frequency-value">N/A</span>';
            label.appendChild(total);
        }
        return total;
    }

    function cpuId(loadElement) {
        for (var i = 0; i < loadElement.classList.length; i++) {
            var match = /^cpu(\d+)$/.exec(loadElement.classList[i]);
            if (match) return parseInt(match[1], 10);
        }
        return null;
    }

    function ensureCoreFrequency(loadElement) {
        var id = cpuId(loadElement);
        if (id === null) return null;

        var label = loadRowLabel(loadElement);
        if (!label) return null;

        var selector = '[data-cpufreq-core="' + id + '"]';
        var existing = label.querySelector(selector);
        if (existing) {
            syncFrequencyColor(existing, loadElement);
            return existing;
        }

        var frequency = frequencyElement('cpufreq-frequency cpufreq-frequency-core', 'data-cpufreq-core', String(id));
        syncFrequencyColor(frequency, loadElement);
        label.appendChild(frequency);
        return frequency;
    }

    function fieldsAreConnected(fields) {
        if (!fields || !fields.average || !fields.average.isConnected ||
            !fields.averageLoad || !fields.averageLoad.isConnected) return false;

        var ids = Object.keys(fields.cores);
        if (ids.length === 0) return false;
        for (var i = 0; i < ids.length; i++) {
            if (!fields.cores[ids[i]] || !fields.cores[ids[i]].isConnected ||
                !fields.coreLoads[ids[i]] || !fields.coreLoads[ids[i]].isConnected) return false;
        }
        return true;
    }

    function ensureFrequencyFields(tile) {
        if (cachedTile === tile && fieldsAreConnected(cachedFields)) return cachedFields;

        var fields = {
            average: ensureTotalFrequency(tile),
            averageLoad: tile.querySelector('span.cpu.load'),
            cores: {},
            coreLoads: {}
        };
        var loads = tile.querySelectorAll('span[class*="load"]');

        for (var i = 0; i < loads.length; i++) {
            var id = cpuId(loads[i]);
            if (id === null) continue;
            var field = ensureCoreFrequency(loads[i]);
            if (field) {
                fields.cores[id] = field;
                fields.coreLoads[id] = loads[i];
            }
        }

        cachedTile = tile;
        cachedFields = fields;
        return fields;
    }

    function updateFields(data) {
        var tile = cpuTile();
        if (!tile || !data) return;

        var fields = ensureFrequencyFields(tile);
        if (fields.average) {
            syncFrequencyColor(fields.average, fields.averageLoad);
            var averageValue = fields.average.querySelector('.cpufreq-frequency-value');
            if (averageValue) averageValue.textContent = formatFrequency(data.avg_mhz);
        }

        var readings = {};
        var cores = Array.isArray(data.cores) ? data.cores : [];
        cores.forEach(function(core) {
            if (!core) return;
            readings[core.cpu !== undefined ? core.cpu : core.core] = core.mhz;
        });

        Object.keys(fields.cores).forEach(function(id) {
            if (!fields.cores[id]) return;
            syncFrequencyColor(fields.cores[id], fields.coreLoads[id]);
            fields.cores[id].textContent = formatFrequency(readings[id]);
        });
    }

    function stopObserver() {
        if (observer) observer.disconnect();
        observer = null;
        if (observerTimer !== null) window.clearTimeout(observerTimer);
        observerTimer = null;
    }

    function stopPolling() {
        if (pollTimer !== null) window.clearInterval(pollTimer);
        pollTimer = null;
    }

    function stopRequest() {
        if (!request) return;
        var pending = request;
        request = null;
        pending.abort();
    }

    function refresh() {
        if (document.hidden || request) return;

        var tile = cpuTile();
        if (!tile) {
            stopPolling();
            cachedTile = null;
            cachedFields = null;
            waitForTile();
            return;
        }

        var current = $.ajax({ url: endpoint, dataType: 'json', timeout: 4000 });
        request = current;
        current
            .done(function(data) { updateFields(data); })
            .fail(function(_xhr, status) {
                if (status !== 'abort') updateFields({ avg_mhz: null, cores: [] });
            })
            .always(function() {
                if (request === current) request = null;
            });
    }

    function startPolling() {
        if (document.hidden || pollTimer !== null) return;
        if (!cpuTile()) {
            waitForTile();
            return;
        }

        stopObserver();
        refresh();
        pollTimer = window.setInterval(refresh, refreshMs);
    }

    function waitForTile() {
        if (document.hidden || observer || cpuTile()) {
            if (cpuTile()) startPolling();
            return;
        }

        if (window.MutationObserver) {
            observer = new MutationObserver(function() {
                if (cpuTile()) startPolling();
            });
            observer.observe(document.body, { childList: true, subtree: true });
            observerTimer = window.setTimeout(stopObserver, observerWaitMs);
        }
    }

    function deactivate() {
        stopPolling();
        stopObserver();
        stopRequest();
    }

    function activate() {
        if (document.hidden) {
            deactivate();
            return;
        }
        if (cpuTile()) startPolling();
        else waitForTile();
    }

    $(function() {
        activate();
        document.addEventListener('visibilitychange', activate);
        window.addEventListener('pagehide', deactivate);
        window.addEventListener('pageshow', activate);
    });
})();
</script>
]]>
</INLINE>
</FILE>

<!-- Install script -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
# Set proper permissions
chmod 644 /usr/local/emhttp/plugins/cpufreq/cpufreq.php
chmod 644 /usr/local/emhttp/plugins/cpufreq/cpufreqdash.page

# Remove obsolete UI files from previous versions
rm -f /usr/local/emhttp/plugins/cpufreq/CPUFreq.page
rm -f /usr/local/emhttp/plugins/cpufreq/cpufreq.page
rm -f /usr/local/emhttp/plugins/cpufreq/dashboard.page
rm -rf /usr/local/emhttp/plugins/cpufreq/dashboard

# Clean any stale state
rm -f /tmp/cpufreq_*.json 2>/dev/null

echo ""
echo "----------------------------------------------------"
echo " cpufreq plugin installed successfully."
echo " - Dashboard: native CPU tile includes per-CPU frequency"
echo " - Average frequency: shown in the Overall Load row"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!-- Remove script -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
# Remove plugin files
rm -rf /usr/local/emhttp/plugins/cpufreq
rm -rf /boot/config/plugins/cpufreq
rm -f /tmp/cpufreq_*.json 2>/dev/null

echo ""
echo "cpufreq plugin removed."
echo ""
]]>
</INLINE>
</FILE>

</PLUGIN>
